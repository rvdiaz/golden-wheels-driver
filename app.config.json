{
  "expo": {
    "name": "Servora",
    "slug": "servora",
    "version": "0.0.1",
    "web": {
      "favicon": "assets/logo.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to attach screenshots or images when submitting feedback."
        }
      ],
      "expo-notifications"
    ],
    "orientation": "portrait",
    "icon": "assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myvirtualboss.realestate",
      "buildNumber": "1",
      "infoPlist": {
        "NSContactsUsageDescription": "We use your contacts to help you import or export CRM records more easily. Contacts are only uploaded to your account if you give explicit consent."
      },
      "icon": "assets/logo.png"
    },
    "android": {
      "package": "com.myvirtualboss.realestate",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "GRAPHQL_ENDPOINT": "http://192.168.1.145:4001/graphql",
      //"GRAPHQL_ENDPOINT": "https://mliqeu5tf5hqnafxp55hwaekd4.appsync-api.us-east-1.amazonaws.com/graphql",
      "AWS_REGION": "us-east-1",
      "COGNITO_USERPOOL_ID": "us-east-1_rXuolyDGQ",
      "COGNITO_CLIENT_ID": "4r6sj034uhg0nvhmn4m3nl24ec",
      //      "APPLE_APP_ID": 6752781766,
      "eas": {
        "projectId": "777406c6-4dff-46d3-a876-88315ae37291"
      }
    }
  }
}
