      "TRAINING_CATEGORY_ID": "431bcd10-c7f0-4e42-835b-bef57d2be968",
      "TENANTID": "usa-my-own-boss",
      "eas": {
        "projectId": "777406c6-4dff-46d3-a876-88315ae37291"
      }
    }
  }
}
