{
  "expo": {
    "name": "My Virtual Boss",
    "slug": "my-own-boss",
    "version": "1.1.1",
    "web": {
      "favicon": "assets/playstore.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access your contacts to import business contacts."
        }
      ],
      "expo-notifications"
    ],
    "orientation": "portrait",
    "icon": "assets/playstore.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "assets/playstoretrans.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myvirtualboss.realestate",
      "buildNumber": "13",
      "infoPlist": {
        "NSContactsUsageDescription": "We use your contacts to help you import or export CRM records more easily. Contacts are only uploaded to your account if you give explicit consent."
      },
      "icon": "assets/playstore.png"
    },
    "android": {
      "package": "com.myvirtualboss.realestate",
      "versionCode": 13,
      "edgeToEdgeEnabled": true
    },
    "extra": {
      //"GRAPHQL_ENDPOINT": "http://localhost:4000/graphql",
